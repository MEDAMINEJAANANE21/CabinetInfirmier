@startuml
 class Cabinet{
  nom : string
  adresse : Adresse 
  infirmiers : Infirmiers
  patients : Patients
 }
 
 class Adresse{
 numéro : int {optionnel}
 rue : string
 codePostal : CodePostal
 ville : string
 étage : int {optionnel} 
 }

 class CodePostal << pattern >> {
  «(0[1-9]|[1-9][0-9]|2A|2B|9[78])\d{3}»
 }
 
 class Patients{
  patient : List(Patient)
  }
 class Patient{
   nom : string
   prénom : string
   naissance : date 
   numéro : NIR {attribut + unique}
   sexe : Sexe
   adresse : Adresse
   visite : Visite
   }
 class NIR << pattern >>{
    << [12]\d{2}(0[1-9]|1[0-2])(0[1-9]|[1-8]\d|9[0-5]|99)\d{3}\d{3}\d{2} >>
 }
 class Visite{
     acte :Acte
     date : date {attribut}
     intervenant: int {attribut}
 }
 class Infirmiers{
      infirmier : List(Infirmier)
 }
 class Infirmier{
       id : ID {attribut + unique}
       nom : string
       prénom : string
       photo : Photo
 }
 enum Sexe{
         M
         F
 }
  class Acte{
          id : ID {attribut + unique}
  }   
  class ID << pattern >> {
    << [0-9]{3} >>
  }
  
  Cabinet  *--  "1" Patients
  Cabinet  *--  "1" Infirmiers
  Cabinet "1" *--  "1" Adresse
  Infirmiers  *-- "*" Infirmier
  Patient "1" *-- "1" NIR
  Patient  *-- "1" Adresse
  Patients    *-- "*" Patient
  Patient "1"  *--  "*" Visite
  Patient "*" *--  "1" Sexe
  Visite  "*" *--  "*"  Acte
  Adresse "*" *--  "1" CodePostal
  ID *-- "1" Infirmier
  ID *-- "1" Acte
  
 note left of Cabinet
    <<racine>> cabinet
 end note
@enduml
